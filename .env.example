# SG Properties Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL URL; when running Prisma with PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgproperties?schema=public"

# Admin Authentication Secret & JWT
AUTH_SECRET="sg-properties-ultra-secure-jwt-key-change-in-production-2026"

# Leads Notification & Email
EMAIL_API_KEY=""
LEADS_NOTIFICATION_EMAIL="advisory@sgproperties.com"

# Object Storage (S3 compatible)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

